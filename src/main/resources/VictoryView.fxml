<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" styleClass="VictoryBackground" stylesheets="@Styles.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cincuentazo.controller.VictoryController">
    <children>
        <!-- Victory Title Image -->
        <ImageView fitHeight="98.0" fitWidth="333.0" layoutX="264.0" layoutY="60.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@com.cincuentazo.images/VictoryTittle.png" />
            </image>
        </ImageView>

        <!-- Winner Name Label -->
        <Label fx:id="winnerLabel" alignment="CENTER" layoutX="219.0" layoutY="245.0" prefHeight="100.0" prefWidth="422.0" style="-fx-text-fill: gold;" text="WINNER!" textFill="#FFD700">
            <font>
                <Font name="Dungeon" size="45.0" />
            </font>
        </Label>

        <!-- Congratulations Message -->
        <Label alignment="CENTER" layoutX="219.0" layoutY="365.0" prefHeight="50.0" prefWidth="422.0" style="-fx-text-fill: white;" text="Congratulations!" textFill="WHITE">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>

        <!-- Play Again Button -->
        <Button fx:id="playAgainButton" layoutX="280.0" layoutY="455.0" onAction="#handlePlayAgain" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8;" text="Play Again">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Button>

        <!-- Exit Button -->
        <Button fx:id="exitButton" layoutX="450.0" layoutY="455.0" onAction="#handleExit" prefHeight="50.0" prefWidth="150.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8;" text="Exit">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Button>
    </children>
</AnchorPane>
