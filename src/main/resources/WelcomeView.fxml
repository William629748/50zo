<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" styleClass="MainMenu" stylesheets="@Styles.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cincuentazo.controller.WelcomeViewController">
    <children>
        <fx:define>
            <ToggleGroup fx:id="playerCountGroup" />
        </fx:define>

        <Button fx:id="startButton" layoutX="375.0" layoutY="400.0" mnemonicParsing="false" onAction="#handleStartGame" styleClass="poker-chip-button" stylesheets="@Styles.css" />
        <Button fx:id="rulesButton" layoutX="188.0" layoutY="400.0" mnemonicParsing="false" onAction="#handleShowRules" styleClass="poker-chip-button2" stylesheets="@Styles.css" />
        <Button fx:id="exitButton" layoutX="563.0" layoutY="400.0" mnemonicParsing="false" onAction="#handleExit" styleClass="poker-chip-button3" stylesheets="@Styles.css" />

        <ImageView fitHeight="412.0" fitWidth="428.0" layoutX="246.0" layoutY="-57.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@com.cincuentazo.images/Tittle.png" />
            </image>
        </ImageView>

        <TextField fx:id="usernameField" alignment="CENTER" focusTraversable="false" layoutX="324.0" layoutY="282.0" prefHeight="87.0" prefWidth="255.0" promptText="Ingresa Tu Usuario" styleClass="TextField" stylesheets="@Styles.css" />
        <RadioButton fx:id="radio1Player" layoutX="45.0" layoutY="230.0" mnemonicParsing="false" text="1 Oponente" textFill="WHITE">
         <toggleGroup>
            <ToggleGroup fx:id="playerCountGroup" />
         </toggleGroup>
         <font>
            <Font name="Onyx" size="26.0" />
         </font></RadioButton>
        <RadioButton fx:id="radio2Players" layoutX="45.0" layoutY="283.0" mnemonicParsing="false" text="2 Oponentes" textFill="WHITE" toggleGroup="$playerCountGroup">
         <font>
            <Font name="Onyx" size="26.0" />
         </font></RadioButton>
        <RadioButton fx:id="radio3Players" layoutX="45.0" layoutY="338.0" mnemonicParsing="false" text="3 Oponentes" textFill="WHITE" toggleGroup="$playerCountGroup">
         <font>
            <Font name="Onyx" size="26.0" />
         </font></RadioButton>
      <ImageView fitHeight="68.0" fitWidth="183.0" layoutX="22.0" layoutY="149.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@com.cincuentazo.images/PickPlayersTittle.png" />
         </image>
      </ImageView>

    </children>
</AnchorPane>
